{
  "name": "HolyC",
  "scopeName": "source.holyc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#preprocessor" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#definition" },
    { "include": "#call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.holyc", "match": "//.*$" },
        { "name": "comment.block.holyc", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.holyc",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.holyc", "match": "\\\\." },
            { "name": "constant.other.placeholder.holyc", "match": "%[-+ #0]*\\d*(\\.\\d+)?(l|ll|h)?[diouxXcsfeEgGpn%]" }
          ]
        },
        {
          "name": "string.quoted.single.holyc",
          "begin": "'", "end": "'",
          "patterns": [{ "name": "constant.character.escape.holyc", "match": "\\\\." }]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*(?:include|define|undef|ifdef|ifndef|if|elif|else|endif|link|exe|help_index))\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.holyc" },
            "2": { "name": "meta.preprocessor.holyc" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.holyc", "match": "\\b(U0|I0|U8|I8|U16|I16|U32|I32|U64|I64|F32|F64|Bool)\\b" },
        { "name": "storage.type.class.holyc", "match": "\\b(class|union)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.holyc", "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|goto|start|end|try|catch|throw)\\b" },
        { "name": "storage.modifier.holyc", "match": "\\b(extern|_extern|public|static|import|_import|reg|noreg|no_warn|lock|interrupt|haserrcode|argpop|noargpop|lastclass|asm)\\b" },
        { "name": "keyword.operator.sizeof.holyc", "match": "\\b(sizeof|offset)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.holyc", "match": "\\b(TRUE|FALSE|NULL|ON|OFF)\\b" },
        { "name": "constant.other.caps.holyc", "match": "\\b[A-Z][A-Z0-9_]{2,}\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.holyc", "match": "\\b0[xX][0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.holyc", "match": "\\b\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\b" }
      ]
    },
    "definition": {
      "match": "^\\s*(?:public\\s+)?([A-Za-z_]\\w*)\\s*\\**\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "storage.type.holyc" },
        "2": { "name": "entity.name.function.holyc" }
      }
    },
    "call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.holyc" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.holyc", "match": "(->|\\+\\+|--|<<|>>|<=|>=|==|!=|&&|\\|\\||[-+*/%=<>!&|^~?:])" }
      ]
    }
  }
}
